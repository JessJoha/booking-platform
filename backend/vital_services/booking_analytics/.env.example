# Database configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/booking_analytics

# Flask configuration
FLASK_ENV=development
SECRET_KEY=your-super-secret-key-for-booking-analytics

# Redis configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# External service URLs
USER_MANAGEMENT_URL=http://localhost:5000
RESERVATION_MANAGEMENT_URL=http://localhost:3000
SPACE_MANAGEMENT_URL=http://localhost:4000
PAYMENT_GATEWAY_URL=http://localhost:50051

# Analytics configuration
PREDICTION_DAYS_AHEAD=7
MIN_TRAINING_DATA_POINTS=10
DEFAULT_CONFIDENCE_THRESHOLD=0.7

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/analytics.log

# Application configuration
PORT=5002
HOST=0.0.0.0
DEBUG=True

# Machine learning configuration
ML_MODEL_CACHE_TTL=3600
ENABLE_PREDICTIVE_ANALYTICS=True
AUTO_RETRAIN_MODELS=True
RETRAIN_INTERVAL_HOURS=24
